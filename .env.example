# Copy to .env for local development. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# Notion internal integration secret (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID of the Leads database (printed by scripts/setup_notion_db.py)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret ElevenLabs sends in the X-Webhook-Secret header (min 16 chars).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional
LOG_LEVEL=INFO
TIMEZONE=America/Mexico_City
